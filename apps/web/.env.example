# Cloudflare discovery worker base URL. Set at build time when the SPA is
# deployed to Cloudflare Pages so the QR-deep-link flow can resolve the
# agent's current quick-tunnel URL from a short-lived temp key.
#
# Empty / unset = embedded mode: SPA assumes it's served by the agent on the
# same origin as the API. No discovery lookup is performed; the existing
# OTK/code/permanent-key paths are unaffected.
#
# Production target after Phase 5 (custom domain):
#   VITE_DISCOVERY_URL=https://oxiremote.app
# Until then, point at the workers.dev URL printed by `wrangler deploy`:
#   VITE_DISCOVERY_URL=https://oxiremote-discovery.<account>.workers.dev
VITE_DISCOVERY_URL=
