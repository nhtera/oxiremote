{
  "name": "oxiremote",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --parallel dev:agent dev:web",
    "dev:h264": "bun run --parallel dev:agent:h264 dev:web",
    "dev:audio": "bun run --parallel dev:agent:audio dev:web",
    "dev:web": "bun --cwd apps/web dev",
    "dev:agent": "cargo run --manifest-path agent/Cargo.toml",
    "dev:agent:h264": "OXI_VIDEO_PIPELINE=h264 cargo run --manifest-path agent/Cargo.toml --features h264",
    "dev:agent:audio": "cargo run --manifest-path agent/Cargo.toml --features audio",
    "dev:landing": "bun --cwd apps/landing dev",
    "dev:discovery": "bun --cwd apps/discovery-worker dev",
    "build": "bun run build:web && cargo build --manifest-path agent/Cargo.toml",
    "build:release": "bun run build:web && cargo build --release --manifest-path agent/Cargo.toml",
    "build:web": "bun --cwd apps/web build",
    "build:landing": "bun --cwd apps/landing build",
    "deploy:web": "bun run build:web && wrangler pages deploy apps/web/dist --project-name oxiremote-web --branch main --commit-dirty=true",
    "deploy:landing": "bun run build:landing && wrangler pages deploy apps/landing/dist --project-name oxiremote-landing --branch main --commit-dirty=true",
    "deploy:discovery": "bun --cwd apps/discovery-worker deploy",
    "typecheck:web": "bun --cwd apps/web typecheck",
    "typecheck:landing": "bun --cwd apps/landing typecheck",
    "lint:web": "bun --cwd apps/web lint",
    "test:web": "bun --cwd apps/web test",
    "e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "check:bundle": "bun run scripts/check-bundle-size.ts",
    "check:versions": "bash scripts/release/check-versions.sh",
    "check:release-assets": "node npm-wrapper/scripts/verify-release-assets.js",
    "smoke:npm-wrapper": "node scripts/release/npm-wrapper-smoke.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
